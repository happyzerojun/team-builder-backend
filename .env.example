# docker compose 용 환경변수 (실제 값은 .env에 작성, 커밋 금지)
DB_ROOT_PASSWORD=change-me
DB_PASSWORD=change-me
GEMINI_API_KEY=
# 스키마 자동 변경: 로컬은 update, 운영은 스키마 확인 후 validate 권장 (docs/troubleshooting.md TS-14)
JPA_DDL_AUTO=update
# 소셜 로그인은 Google만 사용 (Kakao·Naver 버튼 제거, TS-21)
# Google Cloud Console의 승인된 리디렉션 URI: {백엔드 주소}/login/oauth2/code/google
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# JWT 서명 키(HS256, 32바이트 이상). 비우면 compose가 기동을 막는다
# 생성 예: openssl rand -base64 48
JWT_SECRET=
# 로그인 성공 후 돌아갈 프론트 화면 (기본: 로컬 Vite)
OAUTH2_REDIRECT_URI=http://localhost:5173/oauth/callback
